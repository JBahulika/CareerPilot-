# Ollama (local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Embeddings & matching (local sentence-transformers)
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_ENABLED=true
HYBRID_SEARCH_ENABLED=true
HYBRID_VECTOR_WEIGHT=0.65
MATCHER_RECALL_TOP_N=50
MATCHER_RERANK_TOP_N=20
MATCHER_LLM_TOP_N=8
SCORE_WEIGHT_EMBED=0.15
SCORE_WEIGHT_SKILL=0.25
SCORE_WEIGHT_RERANK=0.45
SCORE_WEIGHT_LLM=0.15

# Pipeline
TOP_N_JOBS=10
# Resume PDF tailoring paused (set true to re-enable tailor → PDF step)
TAILOR_RESUMES_ENABLED=false
MIN_MATCH_SCORE=60
JOB_SOURCE=all
DISPLAY_PAGE_SIZE=10
MAX_PAGE_SIZE=15
RECENT_JOBS_DAYS=3
EXPERIENCE_FLEX_YEARS=1
DAILY_RECENT_JOBS_DAYS=2
DEFAULT_INCLUDE_REMOTE=true
# Phase 10a — still-hiring (date-based only; never invent when posted_at unknown)
STILL_HIRING_ENABLED=true
STILL_HIRING_DAYS=7
STILL_HIRING_PREFER=true
# Max jobs Aggregate/UI may request (split across boards)
SCRAPE_LIMIT_MAX=2000

# Safe scrape HTTP (Phase 2) — polite delays; captcha pages abort (never solved)
SCRAPE_MIN_DELAY_MS=400
SCRAPE_MAX_DELAY_MS=1200
SCRAPE_MAX_CONCURRENCY=2
SCRAPE_MAX_RETRIES=2
SCRAPE_HEALTH_COOLDOWN_SECONDS=1800

# Phase 5 — optional proxies + stronger 429 backoff
SCRAPE_PROXY_ENABLED=false
# SCRAPE_PROXY_URL=http://user:pass@host:8080
# SCRAPE_PROXY_FILE=data/proxies/list.txt
# Example format: docs/examples/proxies.list.example
SCRAPE_PROXY_ROTATE=true
SCRAPE_429_BASE_DELAY_MS=2000
SCRAPE_429_MAX_DELAY_MS=60000
SCRAPE_429_MAX_RETRIES=5

# Phase 6 — optional board cookies (advanced; never commit files under data/cookies/)
# Put linkedin.txt / indeed.json etc. in data/cookies/ — see docs/examples/cookies.example.md
SCRAPE_COOKIES_ENABLED=false
# SCRAPE_COOKIES_DIR=data/cookies
SCRAPE_COOKIES_STRICT=true
SCRAPE_COOKIE_MIN_DELAY_MS=1500
SCRAPE_COOKIE_MAX_DELAY_MS=4000
SCRAPE_COOKIE_MAX_CONCURRENCY=1

# Daily morning scan (fresh jobs → digest when configured)
DAILY_SCAN_ENABLED=true
DAILY_SCAN_HOUR=9
DAILY_SCAN_MINUTE=0
# Phase 5 — random scan window (when true, ignores fixed HOUR/MINUTE)
DAILY_SCAN_WINDOW_ENABLED=false
DAILY_SCAN_WINDOW_START_HOUR=8
DAILY_SCAN_WINDOW_START_MINUTE=0
DAILY_SCAN_WINDOW_END_HOUR=11
DAILY_SCAN_WINDOW_END_MINUTE=0
# Phase 5 — quiet hours (local time; overnight wrap OK e.g. 22→7)
QUIET_HOURS_ENABLED=false
QUIET_HOURS_START_HOUR=22
QUIET_HOURS_START_MINUTE=0
QUIET_HOURS_END_HOUR=7
QUIET_HOURS_END_MINUTE=0

# Notifications (Phase 4) — digests only; you apply manually (no auto-apply)
# Backends: local | whatsapp | email | both  (local file always written)
NOTIFIER_BACKEND=local
MAX_DIGEST_JOBS=5
# Phase 8 — skip re-notifying the same job unless refresh / score jump
NOTIFY_DEDUPE_ENABLED=true
NOTIFY_RESEND_SCORE_DELTA=10
WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_RECIPIENT=
# SMTP email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
EMAIL_TO=

# Google Drive backup (optional) — or configure on Profile UI
GOOGLE_DRIVE_FOLDER_ID=
# GOOGLE_DRIVE_CREDENTIALS_PATH=data/secrets/gdrive_service_account.json

# Storage
DATABASE_URL=sqlite:///data/careerpilot.db
CHROMA_PATH=data/chroma

# API
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
