# Ollama (local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Embeddings & matching (local sentence-transformers)
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_ENABLED=true
HYBRID_SEARCH_ENABLED=true
HYBRID_VECTOR_WEIGHT=0.65
MATCHER_RECALL_TOP_N=50
MATCHER_RERANK_TOP_N=20
MATCHER_LLM_TOP_N=8
SCORE_WEIGHT_EMBED=0.15
SCORE_WEIGHT_SKILL=0.25
SCORE_WEIGHT_RERANK=0.45
SCORE_WEIGHT_LLM=0.15

# Pipeline
TOP_N_JOBS=10
MIN_MATCH_SCORE=60
JOB_SOURCE=all
DISPLAY_PAGE_SIZE=10
MAX_PAGE_SIZE=15
RECENT_JOBS_DAYS=3
EXPERIENCE_FLEX_YEARS=1
DAILY_RECENT_JOBS_DAYS=2
DEFAULT_INCLUDE_REMOTE=true

# Safe scrape HTTP (Phase 2) — polite delays; captcha pages abort (never solved)
SCRAPE_MIN_DELAY_MS=400
SCRAPE_MAX_DELAY_MS=1200
SCRAPE_MAX_CONCURRENCY=2
SCRAPE_MAX_RETRIES=2
SCRAPE_HEALTH_COOLDOWN_SECONDS=1800

# Daily morning scan at 9 AM (fresh jobs + tailored resumes → WhatsApp when configured)
DAILY_SCAN_ENABLED=true
DAILY_SCAN_HOUR=9
DAILY_SCAN_MINUTE=0

# Notifications (local writes to logs/notifications/; whatsapp when configured)
NOTIFIER_BACKEND=local
WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_RECIPIENT=

# Storage
DATABASE_URL=sqlite:///data/careerpilot.db
CHROMA_PATH=data/chroma

# API
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
