# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/

# Environment & secrets
.env
.env.*
!.env.example

# Cookies / sessions (never commit)
data/cookies/
**/cookies/*.txt
**/cookies/*.json
*.cookie
cookies.txt

# Proxy lists that may contain credentials
proxies.txt
proxy.txt
data/proxies/
**/*proxies*secret*
**/*proxy*secret*

# Local data (privacy: resumes never leave the machine)
resumes/*
!resumes/.gitkeep
generated_resumes/*
!generated_resumes/.gitkeep
jobs/*
!jobs/.gitkeep
logs/*
!logs/.gitkeep
data/
*.db
*.sqlite3
chroma/

# OS / IDE
.DS_Store
.idea/
.vscode/

# Local virtualenvs
cenv/
ui/cenv/
.venv/
venv/
